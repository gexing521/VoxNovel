# 复制为 .env 后按需修改（本地 npm start 与 docker compose 都会读取）

# 服务端口
PORT=3000
# 访问密码（部署到服务器时强烈建议设置；留空表示不需要登录）
APP_PASSWORD=
# 会话签名密钥（可选，留空会根据密码自动生成）
SESSION_SECRET=
# 数据目录（SQLite 数据库、生成的音频都在这里）
# DATA_DIR=./data

# 以下可选：也可以在网页「设置」里配置，网页中的配置优先
# LLM_BASE_URL=https://starlinkaisite.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4.1-flash
# MINIMAX_API_KEY=
# MINIMAX_WS_URL=wss://api.minimaxi.com/ws/v1/t2a_v2
# MINIMAX_API_BASE=https://api.minimaxi.com
# TTS_MODEL=speech-2.8-hd
